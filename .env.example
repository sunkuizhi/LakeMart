# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8081
LOG_LEVEL=INFO

# 下游 Spring Boot 后端地址（本地开发）
LAKEMART_SERVER_URL=http://localhost:8080

# 下游 Spring Boot 后端地址（Docker 容器内使用服务名）
LAKEMART_SERVER_URL=http://lakemart-server:8080

# DeepSeek 配置（填你充值后的真实 Key）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ZHIPUAI_API_KEY=your-zhipuai-api-key-here

# Redis 配置（复用你现有的 Docker Redis）
REDIS_URL=redis://localhost:6379/0

# Redis 配置（Docker 容器内使用服务名）
REDIS_URL=redis://lakemart-redis:6379/0